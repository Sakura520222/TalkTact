<?xml version="1.0" encoding="utf-8"?>
<!--
  只给回环地址开明文 HTTP。

  为什么需要它：开了「本地代理」之后，**App 进程自己**也要走 http://127.0.0.1:port
  （「试一试」页、测试代理、代理状态检查）。targetSdk ≥ 28 时 Android 默认禁止明文，
  于是 App 这边报 `Cleartext HTTP traffic to 127.0.0.1 not permitted`，
  而微信进程那边却能连上 —— 明文策略是**每个应用自己的清单**说了算的
  （issue #5 就是这个：设置页显示「微信侧走过代理 ✅」，可 App 自己连不上）。

  范围**只开回环**：127.0.0.1 / localhost / ::1。真正该防的是把用户填的第三方接口地址
  也放行明文 —— 那个没有放行，也不该放行。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
